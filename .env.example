# Copiar a .env y completar. Esto es para desarrollo.
#
# El contenedor NO lee ningún .env: en el servidor estas mismas variables se
# cargan en Coolify. Ver docs/DESPLIEGUE.md.

# Base y Retratos van al MISMO volumen persistente.
# En el contenedor el Dockerfile ya los apunta a /datos, que es donde se monta.
DATABASE_PATH=./datos/birthday-tracker.sqlite
RETRATOS_PATH=./datos/retratos

# Generar con: openssl rand -base64 32
# Este de acá es corto a propósito: en producción la app se niega a arrancar
# con un secreto de menos de 32 caracteres, para que nadie despliegue el ejemplo.
BETTER_AUTH_SECRET=reemplazame-por-uno-real

# URL pública de la app. Better Auth la usa para las cookies de sesión.
# En el servidor va la URL real, con https si hay dominio.
BETTER_AUTH_URL=http://localhost:3000

# Solo para `pnpm seed:admin` y `pnpm admin:reset`.
# La contraseña tiene un mínimo de 8 caracteres: con menos, el seed falla.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Opcionales. Tienen default y no hace falta ponerlas.
#
# Puerto donde escucha `pnpm start`. En el contenedor ya viene en 3000.
# PORT=3000
#
# Carpeta de migraciones. Por defecto `drizzle/` del repo. Si apunta a una que
# no existe, la app muestra la pantalla de error en vez de arrancar sin tablas.
# MIGRATIONS_PATH=./drizzle
