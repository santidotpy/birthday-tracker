# Copiar a .env y completar.

# Archivo SQLite. En el server va a un volumen persistente de Coolify:
# si vive dentro del contenedor, cada redeploy borra todos los cumpleaños.
DATABASE_PATH=./birthday-tracker.sqlite

# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app. Better Auth la usa para las cookies de sesión.
BETTER_AUTH_URL=http://localhost:3000

# Solo para `pnpm seed:admin`. No hace falta dejarlas en el .env del server.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
