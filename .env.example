# Copiar a .env y completar.

# Base y Retratos van al MISMO volumen persistente de Coolify.
# Si `datos/` vive dentro del contenedor, cada redeploy borra los cumpleaños
# y las fotos. La app arranca igual, vacía, sin avisar.
DATABASE_PATH=./datos/birthday-tracker.sqlite
RETRATOS_PATH=./datos/retratos

# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app. Better Auth la usa para las cookies de sesión.
BETTER_AUTH_URL=http://localhost:3000

# Solo para `pnpm seed:admin`. No hace falta dejarlas en el .env del server.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
