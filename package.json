{
  "name": "birthday-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "auth generate --config src/auth/servidor.ts --output src/db/schema-auth.ts",
    "seed:admin": "tsx scripts/seed-admin.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2"
  }
}
